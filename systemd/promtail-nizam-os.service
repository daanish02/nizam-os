[Unit]
Description=Promtail for nizam-os logs
After=network.target

[Service]
User=root   # root required for access to system log directories
Group=root
ExecStart=/usr/bin/promtail -config.file /etc/promtail/promtail-nizam-os.yaml  # config deployed by 001-foundation.sh from config/promtail.yaml
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
