    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache Tokens — Creation vs Read",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(nizam_llm_cache_creation_tokens_total{model=~\"$model\",model!=\"\",profile=~\"$profile\"}[5m]) * 60)", "legendFormat": "Creation tok/min", "refId": "A" },
        { "expr": "sum(rate(nizam_llm_cache_read_tokens_total{model=~\"$model\",model!=\"\",profile=~\"$profile\"}[5m]) * 60)", "legendFormat": "Read tok/min", "refId": "B" }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Creation tok/min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF9830" } }] },
          { "matcher": { "id": "byName", "options": "Read tok/min" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#00D4A3" } }] }
        ]
      }
    },

    {
      "id": 13,
      "type": "timeseries",
