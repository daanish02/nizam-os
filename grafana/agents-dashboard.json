    {
      "id": 20,
      "type": "heatmap",
      "title": "Token Spend — Activity Heatmap",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "(sum(rate(nizam_llm_input_tokens_total{model!=\"\",profile=~\"$profile\"}[5m])) + sum(rate(nizam_llm_output_tokens_total{model!=\"\",profile=~\"$profile\"}[5m]))) * 60",
          "legendFormat": "tok/min",
          "refId": "A",
          "interval": "5m",
          "format": "time_series"
        }
      ],
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": { "mode": "size", "value": "1d" },
          "yBuckets": { "mode": "count", "value": "8" }
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Reds",
          "reverse": true,
          "min": 0,
          "exponent": 0.5,
          "scale": "exponential",
          "steps": 128
        },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "mode": "single", "showColorScale": true, "yHistogram": true },
        "yAxis": {
          "axisPlacement": "left",
          "decimals": 0,
          "reverse": false,
          "unit": "short"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "scaleDistribution": { "type": "linear" }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },

    {
      "id": 23,
      "type": "row",
      "title": "System Health",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 24,
      "type": "stat",
      "title": "Services Up",
      "gridPos": { "x": 0, "y": 43, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "nizam_services_up_total", "legendFormat": "", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }] },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 25,
      "type": "stat",
      "title": "Services Total",
      "gridPos": { "x": 4, "y": 43, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "nizam_services_total", "legendFormat": "", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#5794F2" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#5794F2", "value": null }] },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 26,
      "type": "stat",
      "title": "Availability",
      "gridPos": { "x": 8, "y": 43, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "nizam_services_up_total / nizam_services_total * 100", "legendFormat": "", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#F2495C", "value": null },
              { "color": "#FF9830", "value": 80 },
              { "color": "#73BF69", "value": 95 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 27,
      "type": "timeseries",
      "title": "Availability Over Time",
      "gridPos": { "x": 12, "y": 43, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "nizam_services_up_total / nizam_services_total * 100", "legendFormat": "availability %", "refId": "A" }
      ],
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "hidden", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": []
      }
    },

    {
      "id": 28,
      "type": "table",
      "title": "Service Status",
      "gridPos": { "x": 0, "y": 47, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "nizam_service_up", "instant": true, "legendFormat": "", "refId": "A" }],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "Value #A": false },
            "renameByName": { "service": "Service", "type": "Type", "Value #A": "Up" }
          }
        },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "Service", "desc": false }] } }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Up" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "mappings",
                "value": [
                  { "options": { "0": { "text": "DOWN", "color": "#F2495C", "index": 0 }, "1": { "text": "UP", "color": "#73BF69", "index": 1 } }, "type": "value" }
                ]
              },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#F2495C", "value": null }, { "color": "#73BF69", "value": 1 }] } },
              { "id": "color", "value": { "mode": "thresholds" } },
              { "id": "custom.width", "value": 80 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Type" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          }
        ]
      }
    },

    {
      "id": 19,
      "type": "stat",
      "title": "Total Spend (All Time)",
      "gridPos": { "x": 6, "y": 30, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum(nizam_llm_spend_usd_total{model!=\"\"})", "legendFormat": "", "refId": "A" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null },
              { "color": "#FF9830", "value": 50 },
              { "color": "#F2495C", "value": 100 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    }

  ]
}
